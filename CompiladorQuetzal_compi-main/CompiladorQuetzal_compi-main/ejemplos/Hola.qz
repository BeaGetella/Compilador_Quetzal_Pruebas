entero var n = 0
numero var suma = 0.0
numero var x = 0.0
numero var promedio = 0.0

n = consola.pedir("Cuantos numeros desea promediar?: ").entero()

si (n <= 0) {
    consola.mostrar("Error: n debe ser mayor que 0")
} sino {
    suma = 0.0

    para (entero var i = 1; i <= n; i++) {
        x = consola.pedir(t"Ingrese numero {i}: ").numero()
        suma = suma + x
    }

    promedio = suma / n
    consola.mostrar("Suma: " + suma.texto())
    consola.mostrar("Promedio: " + promedio.texto())
}